# Copy to .env and adjust. Every value has a working default for local dev.

# SQLite needs no setup. Point at Postgres for anything shared:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/health_nexus
DATABASE_URL=sqlite:///./health_nexus.db

# MUST be changed before deploying anywhere real.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Platform commission taken on every payment routed through the app (0.05 = 5%).
COMMISSION_RATE=0.05

# The ML service (ml/) — serves the recommenders, the guidance assistant and the
# daily wellness plan. Start it with:
#     cd ml && uvicorn healthnexus_ml.service:app --port 8100
# Leave unset and every surface falls back to the built-in heuristics and FAQ
# rules, so the product still works — the recommendations are just worse.
# ML_SERVICE_URL=http://127.0.0.1:8100

UPLOAD_DIR=./uploads
